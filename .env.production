VITE_API_BASE_URL=https://aicit-backend.onrender.com

# ── UPI payment (manual / out-of-band) ───────────────────────
# Certificate pricing is enforced server-side (₹250/cert); these only
# affect the payment screen. Override per-environment as needed.
VITE_UPI_VPA=1202946131@airtel
VITE_UPI_PAYEE_NAME=AICIT
VITE_UPI_NOTE=AICIT Certificate Fee
VITE_UPI_UNIT_AMOUNT=250
# Bank-issued static QR image, served from /public. The QR file is at
# public/payment/MainAICITQR.jpeg (or change this path). Leave blank to
# generate the QR dynamically from VITE_UPI_VPA instead.
VITE_UPI_QR_IMAGE=/payment/MainAICITQR.jpeg
